# Every value below matches the code default, so local development works with no
# .env at all. Copy this file only when you need to change something.
#   API → services/api/.env      web → apps/web/.env.local

# --- Web (apps/web/.env.local) ------------------------------------------------

# Base URL of the API. Read at build time by Next.js, so a container build needs
# it as a build arg, not just a runtime env var.
NEXT_PUBLIC_API_URL=http://localhost:8000/v1

# "development" opens the seeded local workspace without a sign-in. Switch both
# web and API auth modes to Firebase together when testing real accounts.
NEXT_PUBLIC_AUTH_MODE=development
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- API (services/api/.env) --------------------------------------------------

# Gates four dev-only behaviours: seeding demo org data on boot, returning raw
# invitation tokens in API responses, allowing uploads when malware scanning is
# unavailable, and exposing exception detail in stream errors.
# MUST be set to something other than "development" in production.
APP_ENV=development

# SQLAlchemy URL, also used by Alembic. Async driver required:
# postgresql+asyncpg://user:pass@host:5432/dbname
DATABASE_URL=sqlite+aiosqlite:///./jules-ai.db

# "development" trusts the X-User-ID header (defaults to user-ayman).
# Any other value requires a verified Firebase bearer token.
AUTH_MODE=development

# Optional Firebase Admin project override. Locally, Firebase mode also needs
# Application Default Credentials or GOOGLE_APPLICATION_CREDENTIALS.
FIREBASE_PROJECT_ID=

# Comma-separated CORS allowlist. Must include your deployed web origin.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Model id passed to the ADK agent. Only used when GOOGLE_API_KEY is set.
GEMINI_MODEL=gemini-3.5-flash

# Doubles as the chat-provider switch: empty streams a canned demo response,
# set switches to real Google ADK. It can be loaded directly from this API env
# file; the app passes it to the Google client without logging its value.
GOOGLE_API_KEY=

# Doubles as the storage switch: empty writes to ./uploads on local disk,
# set writes to that GCS bucket.
GOOGLE_CLOUD_PROJECT=YOUR_GOOGLE_CLOUD_PROJECT_ID
GOOGLE_CLOUD_STORAGE_BUCKET=

# Optional full Document AI Layout Parser processor resource name. When set,
# knowledge PDF ingestion uses its page/table/figure hierarchy before Gemini
# visual enrichment. Leave empty for local pypdf parsing.
DOCUMENT_AI_PROCESSOR_NAME=

# Attachment size cap in bytes (default 50 MB). The 413 messages hardcode
# "50 MB", so change those too if you raise this.
MAX_UPLOAD_BYTES=52428800

# Structured API logs. General request/operation metadata is written to stderr
# and LOG_DIR/api.jsonl. In development only, complete prompts and responses are
# written to the sensitive LOG_DIR/chat-transcripts.jsonl file.
LOG_LEVEL=INFO
LOG_DIR=./logs
LOG_CHAT_TRANSCRIPTS=true

# Knowledge ingestion and retrieval tuning.
KNOWLEDGE_WORKER_POLL_SECONDS=2
KNOWLEDGE_CHUNK_SIZE=1400
KNOWLEDGE_CHUNK_OVERLAP=180
KNOWLEDGE_RETRIEVAL_LIMIT=10
EMBEDDING_MODEL=gemini-embedding-2

# Editable DOCX/PPTX generation. Local development can create files without
# LibreOffice/Poppler, but preview images and visual QA require them. The
# container artifact worker includes both tools.
ARTIFACT_GENERATION_ENABLED=true
ARTIFACT_WORKER_POLL_SECONDS=2
ARTIFACT_MAX_SLIDES=20
ARTIFACT_MAX_DOC_PAGES=30
ARTIFACT_MAX_BYTES=52428800
ARTIFACT_QA_RETRY_COUNT=2
ARTIFACT_RENDER_TIMEOUT_SECONDS=120
